# LogRadar Kubernetes Collectors - .env example
# Copy this file to .env and fill in your values

########################################
# Required credentials
########################################
# Required: LogRadar instance URL
LOGRADAR_URL=https://your-logradar-instance.com

# Required: API token for authentication
API_TOKEN=your-api-token-here

########################################
# General settings
########################################
# Optional: Cluster name (defaults to "my-cluster" if not set)
CLUSTER_NAME=production-cluster

# Optional: App name used to make K8s resource names unique (defaults to "dev")
APP_NAME=dev

# Optional: Kubeconfig path (defaults to $KUBECONFIG or ~/.kube/config)
# KUBECONFIG=/path/to/kubeconfig

########################################
# Stats collector settings
########################################
# Optional: Stats collection interval in milliseconds (default: 10000)
COLLECTION_INTERVAL=10000

########################################
# Log collector target selection
########################################
# Required for log collector: namespace of the target pod
POD_NAMESPACE=default

# Choose ONE of the following to select the pod (either POD_NAME or POD_LABEL_SELECTOR):
# - If you know the exact pod name, set POD_NAME
# - Otherwise, set POD_LABEL_SELECTOR (e.g., app.kubernetes.io/name=my-app)
# Only one should be set at a time.
POD_NAME=
POD_LABEL_SELECTOR=

# Optional: Container name when pod has multiple containers
CONTAINER_NAME=

########################################
# Log collector behavior
########################################
# Optional: Number of log lines to tail initially (default: 100)
LOG_TAIL_LINES=100

# Optional: Polling interval in milliseconds when not following (default: 1000)
POLL_INTERVAL=1000

# Optional: Whether to continuously follow logs (default: true)
FOLLOW_LOGS=true

########################################
# Organization hierarchy (used in payloads)
########################################
# Optional identifiers to categorize metrics/logs (defaults shown in code)
TENANT=default
SYSTEM_TYPE=nonprod      # e.g., prod | nonprod
ENVIRONMENT=dev      # e.g., dev | staging | prod (log collector defaults to POD_NAMESPACE if unset)
APPLICATION=cluster      # stats default "cluster"; logs may auto-detect if unset

########################################
# Deployment convenience (used by deploy-collectors.sh)
########################################
# Optional: Docker registry and image tag
# If not set, script defaults to REGISTRY="ghcr.io/gsotti" and TAG="latest"
REGISTRY=
TAG=

