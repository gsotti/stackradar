# Server Configuration
PORT=8000
NODE_ENV=production

# Security
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h
ADMIN_API_KEY=change-me

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=logpilot
POSTGRES_PASSWORD=logpilot_password
POSTGRES_DB=logpilot

# Frontend
STATIC_PATH=./static

# Build Configuration
# Set to "true" to disable code obfuscation during build (useful for development/debugging)
DISABLE_OBFUSCATION=false

# Admin User (for seeding)
ADMIN_EMAIL=admin@logpilot.local
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin User
